  <Target Name="CopyGameDllToAssets" AfterTargets="Build">
    <PropertyGroup>
      <GameDllAssetsDir>$(ProjectDir)..\Assets\GameDll\</GameDllAssetsDir>
      <Pdb2MdbExe>$(ProjectDir)..\pdb2mdb.exe</Pdb2MdbExe>
      <GameDllMdbPath>$(TargetPath).mdb</GameDllMdbPath>
    </PropertyGroup>
    <MakeDir Directories="$(GameDllAssetsDir)" />
    <Exec Command="&quot;$(Pdb2MdbExe)&quot; &quot;$(TargetPath)&quot;" Condition="Exists('$(Pdb2MdbExe)') And Exists('$(TargetDir)$(TargetName).pdb')" />
    <Warning Text="pdb2mdb.exe不存在，跳过mdb生成：$(Pdb2MdbExe)" Condition="!Exists('$(Pdb2MdbExe)')" />
    <Warning Text="$(TargetName).pdb不存在，跳过mdb生成：$(TargetDir)$(TargetName).pdb" Condition="Exists('$(Pdb2MdbExe)') And !Exists('$(TargetDir)$(TargetName).pdb')" />
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(GameDllAssetsDir)$(TargetFileName).bytes" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(GameDllMdbPath)" DestinationFiles="$(GameDllAssetsDir)$(TargetName).mdb.bytes" SkipUnchangedFiles="true" Condition="Exists('$(GameDllMdbPath)')" />
  </Target>
