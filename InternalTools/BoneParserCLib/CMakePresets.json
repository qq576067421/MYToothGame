{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-x64-msvc-release",
      "displayName": "Windows x64 MSVC Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-x64-msvc-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BONE_PARSER_CLIB_COPY_TO_UNITY": "ON"
      }
    },
    {
      "name": "windows-x64-msvc-debug",
      "displayName": "Windows x64 MSVC Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-x64-msvc-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BONE_PARSER_CLIB_COPY_TO_UNITY": "ON"
      }
    },
    {
      "name": "android-arm64-v8a-release",
      "displayName": "Android arm64-v8a Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/android-arm64-v8a-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-30",
        "ANDROID_STL": "c++_static",
        "BONE_PARSER_CLIB_COPY_TO_UNITY": "ON"
      }
    },
    {
      "name": "android-armeabi-v7a-release",
      "displayName": "Android armeabi-v7a Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/android-armeabi-v7a-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "ANDROID_ABI": "armeabi-v7a",
        "ANDROID_PLATFORM": "android-30",
        "ANDROID_STL": "c++_static",
        "BONE_PARSER_CLIB_COPY_TO_UNITY": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64-msvc-release"
    },
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64-msvc-debug"
    },
    {
      "name": "android-arm64-v8a-release",
      "configurePreset": "android-arm64-v8a-release"
    },
    {
      "name": "android-armeabi-v7a-release",
      "configurePreset": "android-armeabi-v7a-release"
    }
  ]
}
