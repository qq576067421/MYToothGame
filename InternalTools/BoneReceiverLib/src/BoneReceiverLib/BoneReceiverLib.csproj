<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>BoneReceiverLib</AssemblyName>
    <RootNamespace>CompanyInternalTools.BoneReceiverLib</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <Target Name="CopyToMainProject" AfterTargets="Build">
    <PropertyGroup>
      <BoneNetDir>$(MSBuildThisFileDirectory)..\..\..\..\Project\GameProject\Assets\Scripts\Game\BattleLogic\Battle\BoneInput\Net\</BoneNetDir>
    </PropertyGroup>
    <MakeDir Directories="$(BoneNetDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BoneNetDir)" />
    <Copy
      SourceFiles="$(TargetDir)$(AssemblyName).pdb"
      DestinationFolder="$(BoneNetDir)"
      Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
  </Target>
</Project>
